# Base URL of the API gateway (REST endpoints).
VITE_API_URL=http://localhost:8080

# Base URL of the Socket.IO server used by the battle service.
VITE_WS_URL=http://localhost:8080

# Microsoft Entra ID (MSAL): application (client) id and tenant id of the
# DanceSync app registration. Left empty, "Sign in with Microsoft" is disabled
# and only guests (with a room code) can get in.
# VITE_AZURE_TENANT_ID: "common" lets anyone with a Microsoft account sign in
# (any organization or personal); a tenant id restricts it to that tenant.
# Use the same value as AZURE_TENANT_ID in the backend.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=common
# Optional. Scope of the DanceSync API requested at sign-in;
# defaults to api://<VITE_AZURE_CLIENT_ID>/access_as_user.
VITE_AZURE_API_SCOPE=
